# 应用信息
APP_NAME="企业知识库与工单协作 Agent 平台"
APP_VERSION="0.1.0"
HOST=127.0.0.1
PORT=8002
RELOAD=true

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=enterprise_support
DB_USER=support_app
DB_PASSWORD=replace-with-local-database-password

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# S3兼容对象存储（本地开发使用RustFS）
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_BUCKET=enterprise-knowledge
STORAGE_REGION=us-east-1
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=enterprise_support_document_chunks
QDRANT_PREFER_GRPC=false
# 本地无认证时留空；云服务环境填写真实API Key。
QDRANT_API_KEY=

# Embedding服务
EMBED_MODEL_NAME=replace-with-embedding-model-name
EMBED_API_KEY=replace-with-embedding-api-key
EMBED_BASE_URL=replace-with-openai-compatible-base-url

# Rerank服务
RERANK_MODEL_NAME=qwen3-rerank
RERANK_API_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_API_KEY=replace-with-rerank-api-key
RERANK_REQUEST_TIMEOUT_SECONDS=30
RERANK_MAX_RETRIES=2
RERANK_MAX_DOCUMENTS=50
RERANK_MAX_DOCUMENT_CHARACTERS=3500